[Unit]
Description=Encrypted PostgreSQL backup for email-sucks
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
User=exedev
Group=exedev
ExecStart=/home/exedev/email-sucks/bin/vm-backup
UMask=0077
TimeoutStartSec=15min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/exedev/backups/email-sucks
